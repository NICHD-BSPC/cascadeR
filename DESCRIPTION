Package: cascadeR
Title: Shiny App to Explore Single-Cell Analysis
Version: 0.99.0
Authors@R:
    c(
        person("Apratim", "Mitra", , "apratim.mitra@gmail.com",
               role = c("aut", "cre"), comment = c(ORCID = "0000-0003-3279-0054")),
